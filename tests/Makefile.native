# Host tests for the scheduler's queue and task-state logic.
CC = cc
CFLAGS = -O2 -g -Wall -Wextra -Werror -std=c11 -DSS_HOST_TEST -DSS_TASK_CREATE_PROBE \
	-Iframework -I../ssos/os/kernel

ifeq ($(SANITIZE),1)
CFLAGS += -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer
TARGET = test_runner_native_sanitize
else
TARGET = test_runner_native
endif

SSOS = ../ssos/os
SOURCES = framework/test_runner.c framework/test_mocks.c unit/test_scheduler.c \
	$(SSOS)/kernel/scheduler.c $(SSOS)/kernel/preemptive/wakeups.c
HEADERS = $(wildcard framework/*.h unit/*.h $(SSOS)/kernel/*.h)

.PHONY: all test clean
all: $(TARGET)

test: $(TARGET)
	./$(TARGET)

$(TARGET): $(SOURCES) $(HEADERS) Makefile.native
	$(CC) $(CFLAGS) $(SOURCES) -o $@

clean:
	rm -rf build test_runner_native test_runner_native_sanitize
